# --- Azure OpenAI (default) -------------------------------------------------
# Use the resource's /openai/v1 surface -- it speaks the OpenAI wire protocol,
# so no api-version and no /deployments/{name}/ path building is needed.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=<your-azure-key>

# The part after the colon is the DEPLOYMENT name, not the base model name.
# `python run.py --check` lists the deployments this resource actually serves.
# TLIFE_MODEL=azure:gpt-5.4-mini
# TLIFE_ROUTINE_MODEL=azure:<cheaper-deployment>   # desks only; triage stays strong

# --- Other providers --------------------------------------------------------
# TLIFE_MODEL=openai:gpt-4.1                 needs OPENAI_API_KEY
# TLIFE_MODEL=anthropic:claude-opus-5        needs langchain-anthropic + ANTHROPIC_API_KEY
# OPENAI_API_KEY=sk-...

# --- Guardrail backend ------------------------------------------------------
# llm = rules written into the agent's prompt + a chat model judging JSON
# jev = rules asked as typed questions; the prompt carries no rules at all
# TLIFE_GUARDRAIL_BACKEND=llm
# TYPESAFE_API_KEY=...              required for the jev backend
# TLIFE_JEV_MODEL=jev-latest
# Jev probabilities are calibrated, so these thresholds actually discriminate:
# TLIFE_JEV_SCOPE_P=0.70            refuse an off-topic turn above this
# TLIFE_JEV_DESK_P=0.70             flag a wrong-desk request above this
# TLIFE_JEV_RULE_P=0.60             record a soft-rule violation above this
# TLIFE_JEV_SAFETY_P=0.40           deliberately low -- a missed safety case is
#                                   far worse than a false alarm

# --- Soft guardrails (LLM scope judge) --------------------------------------
# TLIFE_JUDGE=1                    set to 0 to turn the scope judge off
# TLIFE_JUDGE_THRESHOLD=0.75       confidence needed to refuse rather than flag
# TLIFE_JUDGE_MODEL=azure:<cheap>  the judge runs once per customer turn

# --- App --------------------------------------------------------------------
# TLIFE_BRAND=T-Life
# Fix the guardrail sampler so a session replays identically (tests, incident replay)
# TLIFE_GUARDRAIL_SEED=42
